    {
      "parameters": {
        "jsCode": "// Jalur 2 - Sheet 3: menyesuaikan nama kolom & struktur agar sama dengan Master Sheet\nconst TAHUN_DATA = 2025; // Sheet 3 tidak punya kolom tanggal, jadi tahun diisi manual (ubah bila perlu)\n\nconst BULAN = ['januari','februari','maret','april','mei','juni','juli',\n               'agustus','september','oktober','november','desember'];\n\nconst inputData = $input.all();\nconst allRows = inputData.flatMap(item =>\n  Array.isArray(item.json) ? item.json : [item.json]\n);\n\nconst transformedRows = allRows.map(row => {\n  // Gabung Kategori + Nama Produk menjadi satu kolom \"Produk\"\n  const produk = `${row['Kategori Produk'] || ''} ${row['Nama Produk'] || ''}`.trim();\n\n  // Bangun \"Tanggal Laporan\" (tanggal 1 pada bulan terkait), format YYYY-MM-DD\n  const idx = BULAN.indexOf(String(row['Bulan'] || '').toLowerCase());\n  const tanggal = idx >= 0\n    ? `${TAHUN_DATA}-${String(idx + 1).padStart(2, '0')}-01`\n    : '';\n\n  return {\n    'ID Laporan': String(row['ID Laporan'] || '').trim(),\n    'Bulan': String(row['Bulan'] || '').trim(),\n    'Produk': produk,\n    'Wilayah': '-',                                              // Sheet 3 tidak punya data wilayah\n    'Penjualan (Unit)': parseFloat(row['Penjualan Harian']) || 0,\n    'Target (Unit)': 0,                                          // Sheet 3 tidak punya target\n    'Pendapatan (IDR)': parseFloat(row['Total Penjualan (IDR)']) || 0,\n    'Status': String(row['Catatan Status'] || '').trim() || 'Tidak Diketahui',\n    'Keterangan': row['Karyawan Penanggung Jawab']\n      ? `PJ: ${String(row['Karyawan Penanggung Jawab']).trim()}`\n      : '',\n    'Tanggal Laporan': tanggal\n  };\n});\n\nreturn transformedRows.map(row => ({ json: row }));\n"
      },
