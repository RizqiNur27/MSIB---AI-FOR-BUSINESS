    {
      "parameters": {
        "jsCode": "// Jalur 2 - Sheet 3: pembersihan teks (trim) dan konversi tipe data numerik\nconst inputData = $input.all();\n\nconst allRows = inputData.flatMap(item =>\n  Array.isArray(item.json) ? item.json : [item.json]\n);\n\nconst cleaned = allRows.map(row => {\n  const r = { ...row };\n\n  ['ID Laporan', 'Bulan', 'Kategori Produk', 'Nama Produk',\n   'Karyawan Penanggung Jawab', 'Catatan Status'].forEach(k => {\n    if (r[k] !== undefined && r[k] !== null) r[k] = String(r[k]).trim();\n  });\n\n  ['Jumlah Stok', 'Penjualan Harian', 'Harga Satuan (IDR)', 'Total Penjualan (IDR)'].forEach(k => {\n    r[k] = parseFloat(r[k]) || 0;\n  });\n\n  return r;\n});\n\nreturn cleaned.map(row => ({ json: row }));\n"
      },
