    {
      "parameters": {
        "jsCode": "// Generate Laporan: agregasi data gabungan untuk bulan berjalan\n// Opsional: isi manual untuk memaksa bulan tertentu, mis. 'Oktober'. Kosongkan = otomatis bulan berjalan.\nconst BULAN_PAKSA = '';\n\nconst allInputs = $input.all();\nconst allRows = allInputs.flatMap(item =>\n  Array.isArray(item.json) ? item.json : [item.json]\n);\n\nconst now = new Date();\nconst currentMonthName = BULAN_PAKSA ||\n  now.toLocaleString('id-ID', { month: 'long', timeZone: 'Asia/Jakarta' });\nconst currentYear = now.getFullYear();\n\nconst num = v => parseFloat(v) || 0;\n\n// Data bulan berjalan\nconst monthlyData = allRows.filter(row =>\n  String(row.Bulan || '').trim().toLowerCase() === currentMonthName.toLowerCase()\n);\n\nconst totalPenjualanUnit = monthlyData.reduce((s, r) => s + num(r['Penjualan (Unit)']), 0);\nconst totalPendapatan   = monthlyData.reduce((s, r) => s + num(r['Pendapatan (IDR)']), 0);\nconst totalLaporan      = monthlyData.length;\n\n// Rata-rata performa bulanan: total pendapatan seluruh data / jumlah bulan yang ada datanya\nconst bulanUnik = new Set(allRows.map(r => String(r.Bulan || '').trim().toLowerCase()).filter(Boolean));\nconst totalPendapatanSemua = allRows.reduce((s, r) => s + num(r['Pendapatan (IDR)']), 0);\nconst rataPendapatanPerBulan = bulanUnik.size ? totalPendapatanSemua / bulanUnik.size : 0;\n\nconst r2 = n => Number(n.toFixed(2));\n\nconst laporan = {\n  'Bulan': currentMonthName,\n  'Tahun': currentYear,\n  'Jumlah_Laporan': totalLaporan,\n  'Total_Penjualan_Unit': totalPenjualanUnit,\n  'Total_Pendapatan_IDR': totalPendapatan,\n  'Rata_Rata_Penjualan_Per_Laporan': totalLaporan ? r2(totalPenjualanUnit / totalLaporan) : 0,\n  'Rata_Rata_Pendapatan_Per_Laporan': totalLaporan ? r2(totalPendapatan / totalLaporan) : 0,\n  'Rata_Rata_Pendapatan_Per_Bulan': r2(rataPendapatanPerBulan),\n  'Sumber_Data': 'Sheet 1, Sheet 2, Sheet 3',\n  'Terakhir_Diperbarui': now.toISOString()\n};\n\n// Kembalikan HANYA 1 item\nreturn [{ json: laporan }];\n"
      },
