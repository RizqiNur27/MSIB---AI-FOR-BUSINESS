      "parameters": {
        "jsCode": "// Menambahkan kolom \"Sumber\" berdasarkan awalan ID Laporan (REP = Sheet 1, LAP = Sheet 2)\nconst items = $input.all();\n\nreturn items.map(item => {\n  const row = item.json;\n  const id = String(row['ID Laporan'] || '').trim();\n\n  let sumber = 'Unknown';\n  if (id.startsWith('REP')) sumber = 'Sheet1';\n  else if (id.startsWith('LAP')) sumber = 'Sheet2';\n\n  // Susun ulang kolom secara eksplisit agar field bawaan (mis. row_number) tidak ikut tertulis ke Master Sheet\n  return { json: {\n    'ID Laporan': id,\n    'Bulan': String(row['Bulan'] || '').trim(),\n    'Produk': String(row['Produk'] || '').trim(),\n    'Wilayah': String(row['Wilayah'] || '').trim(),\n    'Penjualan (Unit)': parseFloat(row['Penjualan (Unit)']) || 0,\n    'Target (Unit)': parseFloat(row['Target (Unit)']) || 0,\n    'Pendapatan (IDR)': parseFloat(row['Pendapatan (IDR)']) || 0,\n    'Status': String(row['Status'] || '').trim(),\n    'Keterangan': String(row['Keterangan'] || '').trim(),\n    'Tanggal Laporan': row['Tanggal Laporan'] || '',\n    'Sumber': sumber\n  }};\n});\n"
      },
