    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Ekstrak Skor dari Teks AI: ambil angka setelah kata \"Skor:\" dari jawaban LLM\nconst llmOutput = String($json.text || '');\n\n// ID email asli berasal dari Gmail Trigger (output LLM Chain tidak membawa ID email)\nconst email = $('Gmail Trigger').item.json;\nconst emailMessageId = email.id;\n\n// Regex mencari \"Skor: [angka]\" dan mengabaikan spasi yang mungkin ada\nconst match = llmOutput.match(/Skor\\s*:\\s*(\\d+(?:[.,]\\d+)?)/i);\n\n// -1 = skor tidak terbaca. Nilai ini <= 6 sehingga email diarahkan ke tinjauan manual (aman)\nlet score = -1;\nif (match && match[1]) {\n  score = Math.min(10, parseFloat(match[1].replace(',', '.')));\n}\n\nreturn { json: {\n  score,\n  emailMessageId,\n  from: email.From || '',\n  subject: email.Subject || '',\n  snippet: email.snippet || '',\n  llm_output: llmOutput\n}};\n"
      },
